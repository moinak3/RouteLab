{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true
  },
  "include": ["vite.config.ts", "scripts", "src/core", "src/server", "src/types.ts", "src/types/ui.ts", "api/frontier-lab/_runner.ts", "api/jev/_runner.ts", "api/llm-grouping/*.ts", "api/live/_shared.ts", "api/routing-policy/*.ts", "api/sidecar/*.ts", "api/task-group-names.ts", "api/runtime.ts"]
}
