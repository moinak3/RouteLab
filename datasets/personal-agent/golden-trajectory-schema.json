{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routelab.dev/schemas/golden-trajectory-v1.json",
  "title": "RouteLab trajectory golden row",
  "description": "A human label and the exact full-trajectory evidence snapshot evaluated by the LLM judge. Fields ending in _json are JSON-encoded strings when represented in CSV.",
  "type": "object",
  "required": [
    "evidence_schema_version",
    "evaluation_scope",
    "evidence_fingerprint",
    "trace_id",
    "user_request",
    "system_instructions_json",
    "prior_conversation_json",
    "available_tools_json",
    "retrieved_context_json",
    "execution_spans_json",
    "tool_calls_json",
    "tool_results_json",
    "agent_answer",
    "trajectory_status",
    "human_passed",
    "human_score",
    "human_rationale"
  ],
  "properties": {
    "evidence_schema_version": { "const": "routelab.eval-evidence.v1" },
    "evaluation_scope": { "const": "full_trajectory" },
    "evidence_fingerprint": { "type": "string", "pattern": "^fnv1a-[0-9a-f]{8}$" },
    "trace_id": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string" },
    "task_group": { "type": "string" },
    "model": { "type": "string" },
    "user_request": { "type": "string" },
    "system_instructions_json": { "type": "string", "contentMediaType": "application/json" },
    "prior_conversation_json": { "type": "string", "contentMediaType": "application/json" },
    "available_tools_json": { "type": "string", "contentMediaType": "application/json" },
    "retrieved_context_json": { "type": "string", "contentMediaType": "application/json" },
    "execution_spans_json": { "type": "string", "contentMediaType": "application/json" },
    "tool_calls_json": { "type": "string", "contentMediaType": "application/json" },
    "tool_results_json": { "type": "string", "contentMediaType": "application/json" },
    "agent_answer": { "type": "string" },
    "trajectory_status": { "enum": ["success", "error"] },
    "workflow_json": { "type": "string", "contentMediaType": "application/json" },
    "evidence_metadata_json": { "type": "string", "contentMediaType": "application/json" },
    "human_answer": { "type": "string" },
    "human_passed": { "type": "boolean" },
    "human_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "human_severity": { "type": ["string", "null"], "enum": ["minor", "major", "critical", null] },
    "human_rationale": { "type": "string", "minLength": 1 },
    "label_source": { "type": "string" },
    "review_status": { "type": "string" }
  },
  "additionalProperties": true
}
